
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Lato', sans-serif;
}

body {
    color: #1E212C;
    background-color: #FFFFFF;
}

.container {
    max-width: 1230px;
    margin: 0 auto;
    padding: 0 15px;
}

/* Buttons */
.btn {
    display: inline-block;
    padding: 12px 32px;
    border-radius: 4px;
    font-weight: 700;
    font-size: 14px;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
    text-align: center;
}

.btn-primary {
    background: linear-gradient(55.95deg, #FF3F3A 0%, #F75E05 100%);
    color: #fff;
    border: none;
}

.btn-primary:hover {
    opacity: 0.9;
}

.btn-outline {
    border: 1px solid #FF3F3A;
    color: #FF3F3A;
    background: transparent;
    width: 100%;
}

.btn-outline:hover {
    background: linear-gradient(55.95deg, #FF3F3A 0%, #F75E05 100%);
    color: #fff;
}

.full-btn {
    width: 100%;
}

/* Navbar */
.navbar {
    padding: 20px 0;
}

.nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.nav-left {
    display: flex;
    align-items: center;
    gap: 60px;
}

.logo {
    font-size: 24px;
    font-weight: 900;
    text-decoration: none;
    color: #1E212C;
    letter-spacing: 1px;
}

.logo span {
    color: #FF3F3A;
}

.nav-links {
    display: flex;
    gap: 40px;
}

.nav-links a {
    text-decoration: none;
    color: #424551;
    font-weight: 700;
    font-size: 16px;
}

.nav-links a.active, .nav-links a:hover {
    color: #FF3F3A;
}

.nav-right {
    display: flex;
    align-items: center;
    gap: 36px;
}

.auth-link {
    text-decoration: none;
    color: #424551;
    font-weight: 700;
    font-size: 16px;
}

/* Page Header */
.page-header {
    text-align: center;
    padding: 60px 0 40px;
}

.subtitle {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #1E212C;
    display: block;
    margin-bottom: 8px;
}

.main-title {
    font-size: 46px;
    font-weight: 900;
    color: #1E212C;
}

/* Filters */
.filters-section {
    margin-bottom: 40px;
}

.filters-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
}

.filter-group {
    display: flex;
    align-items: center;
    gap: 12px;
}

.filter-group label {
    font-weight: 700;
    font-size: 16px;
    color: #424551;
}

.filter-group select, .show-input, .search-box input {
    padding: 11px 16px;
    border: 1px solid #D7DADD;
    border-radius: 4px;
    font-size: 14px;
    color: #424551;
}

.show-input {
    width: 70px;
}

.per-page {
    font-size: 14px;
    color: #787A80;
}

.search-box {
    position: relative;
}

.search-box input {
    width: 260px;
    padding-right: 35px;
}

.search-box span {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: #787A80;
}

.view-toggles {
    display: flex;
    gap: 12px;
}

.view-btn {
    background: none;
    border: none;
    font-size: 20px;
    cursor: pointer;
    color: #424551;
}

.view-btn.active {
    color: #FF3F3A;
}

/* Events Grid */
.events-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    margin-bottom: 60px;
}

.event-card {
    background: #FFFFFF;
    border: 1px solid #E5E8ED;
    border-radius: 4px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: box-shadow 0.3s ease;
}

.event-card:hover {
    box-shadow: 0px 80px 80px -20px rgba(154, 156, 165, 0.08), 
                0px 30px 24px -10px rgba(154, 156, 165, 0.05);
}

.event-date {
    font-size: 28px;
    font-weight: 900;
    color: #FF3F3A;
    margin-bottom: 4px;
}

.event-time {
    font-size: 16px;
    color: #787A80;
    margin-bottom: 20px;
}

.event-title {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.5;
    color: #1E212C;
    margin-bottom: 8px;
}

.event-type {
    font-size: 16px;
    color: #787A80;
    margin-bottom: 36px;
}

/* Pagination */
.pagination {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-bottom: 100px;
}

.pagination a {
    text-decoration: none;
    font-size: 16px;
    font-weight: 700;
    color: #424551;
}

.pagination a.active, .pagination a:hover {
    color: #FF3F3A;
}

/* Subscribe Banner */
.subscribe-section {
    background-color: #FEDCD2;
    padding: 100px 0;
    text-align: center;
}

.subscribe-container h2 {
    font-size: 46px;
    font-weight: 900;
    max-width: 810px;
    margin: 0 auto 48px;
    line-height: 1.3;
}

.subscribe-form {
    display: flex;
    justify-content: center;
    gap: 24px;
}

.subscribe-form input {
    width: 420px;
    padding: 13px 16px;
    border: 1px solid #D7DADD;
    border-radius: 4px;
    font-size: 16px;
}

/* Footer */
.footer {
    background-color: #1E212C;
    color: #FFFFFF;
    padding-top: 80px;
}

.footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.2fr 2fr;
    gap: 40px;
    padding-bottom: 60px;
}

.footer-logo {
    color: #FFFFFF;
    display: block;
    margin-bottom: 24px;
}

.about-col p {
    font-size: 12px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 38px;
}

.socials {
    display: flex;
    gap: 20px;
}

.socials a {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    font-weight: 700;
}

.footer-col h4 {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 1px;
    margin-bottom: 12px;
}

.footer-col ul {
    list-style: none;
}

.footer-col ul li {
    margin-bottom: 8px;
    font-size: 16px;
    color: rgba(255, 255, 255, 0.6);
}

.footer-col ul li a {
    text-decoration: none;
    color: rgba(255, 255, 255, 0.6);
    transition: color 0.3s;
}

.footer-col ul li a:hover {
    color: #FFFFFF;
}

.footer-form {
    display: flex;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    margin: 24px 0 12px;
}

.footer-form input {
    background: transparent;
    border: none;
    padding: 10px 12px;
    color: #fff;
    width: 100%;
    outline: none;
}

.footer-form button {
    background: transparent;
    border: none;
    color: #fff;
    padding: 0 14px;
    cursor: pointer;
    font-size: 18px;
}

.newsletter-col small {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.5;
    display: block;
}

.footer-bottom {
    background-color: rgba(255, 255, 255, 0.05);
    padding: 20px 0;
}

.bottom-container {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.6);
}

.bottom-container a {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    font-weight: 700;
}

/* Responsive */
@media (max-width: 992px) {
    .events-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    .footer-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    .nav-links {
        display: none;
    }
}

@media (max-width: 600px) {
    .events-grid {
        grid-template-columns: 1fr;
    }
    .subscribe-form {
        flex-direction: column;
        align-items: center;
    }
    .subscribe-form input {
        width: 100%;
    }
}
