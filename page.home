* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Lato', sans-serif;
}

body {
    color: #1E212C;
    background-color: #FFFFFF;
}

.container {
    max-width: 1230px;
    margin: 0 auto;
    padding: 0 15px;
}

/* Buttons */
.btn {
    display: inline-block;
    padding: 13px 32px;
    border-radius: 4px;
    font-weight: 700;
    font-size: 14px;
    text-decoration: none;
    cursor: pointer;
    transition: 0.3s;
    text-align: center;
}

.btn-primary {
    background: linear-gradient(55.95deg, #FF3F3A 0%, #F75E05 100%);
    color: #FFFFFF;
    border: none;
}

.btn-primary:hover {
    opacity: 0.9;
}

.full-btn {
    width: 100%;
    margin-top: 24px;
}

/* Hero & Navbar */
.hero-wrapper {
    background-color: #FEDCD2;
    padding-bottom: 100px;
}

.navbar {
    padding: 20px 0;
}

.nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.nav-left {
    display: flex;
    align-items: center;
    gap: 60px;
}

.logo {
    font-size: 24px;
    font-weight: 900;
    text-decoration: none;
    color: #1E212C;
    letter-spacing: 1px;
}

.logo span {
    color: #FF3F3A;
}

.nav-links {
    display: flex;
    gap: 40px;
}

.nav-links a {
    text-decoration: none;
    color: #424551;
    font-weight: 700;
    font-size: 16px;
}

.nav-links a.active, .nav-links a:hover {
    color: #FF3F3A;
}

.nav-right {
    display: flex;
    align-items: center;
    gap: 36px;
}

.auth-link {
    text-decoration: none;
    color: #424551;
    font-weight: 700;
    font-size: 16px;
}

.event-hero {
    text-align: center;
    padding-top: 80px;
}

.subtitle {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    display: block;
    margin-bottom: 12px;
}

.red-text {
    color: #FF3F3A;
}

.main-title {
    font-size: 46px;
    font-weight: 900;
    max-width: 1020px;
    margin: 0 auto;
    line-height: 1.3;
}

/* Program & Sidebar */
.program-section {
    padding: 120px 0;
}

.program-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 100px;
    align-items: start;
}

.program-content h2 {
    font-size: 46px;
    font-weight: 900;
    margin-bottom: 40px;
}

.accordion-item {
    margin-bottom: 24px;
}

.accordion-header {
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
}

.accordion-header .icon {
    color: #FF3F3A;
    font-size: 22px;
    font-weight: 700;
    width: 20px;
}

.accordion-header .theme-num {
    color: #FF3F3A;
    font-weight: 700;
    font-size: 20px;
}

.accordion-header h3 {
    font-size: 20px;
    font-weight: 700;
    color: #1E212C;
}

.accordion-body {
    padding-left: 32px;
    margin-top: 16px;
    color: #424551;
    font-size: 16px;
    line-height: 1.6;
}

/* Info Card */
.info-card {
    background: #FFFFFF;
    border: 1px solid #E5E8ED;
    border-radius: 4px;
    padding: 40px 32px;
    box-shadow: 0px 80px 80px -20px rgba(154, 156, 165, 0.08), 
                0px 30px 24px -10px rgba(154, 156, 165, 0.05);
}

.info-block {
    margin-bottom: 32px;
}

.info-label {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #1E212C;
    display: block;
    margin-bottom: 4px;
}

.info-value {
    font-size: 24px;
    font-weight: 700;
    color: #FF3F3A;
    margin-bottom: 8px;
}

.info-desc {
    font-size: 16px;
    color: #787A80;
    line-height: 1.6;
}

.fb-link {
    display: inline-block;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #FF3F3A;
    text-decoration: underline;
    margin-bottom: 16px;
}

/* Speaker Section */
.speaker-section {
    padding: 60px 0 120px;
}

.speaker-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 100px;
    align-items: center;
}

.yellow-bg {
    background-color: #FFCF2D;
    border-radius: 4px;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    height: 480px;
}

.yellow-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.speaker-info h2 {
    font-size: 46px;
    font-weight: 900;
    margin-bottom: 12px;
}

.speaker-role {
    font-size: 20px;
    color: #787A80;
    margin-bottom: 32px;
}

.speaker-bio {
    font-size: 16px;
    color: #424551;
    line-height: 1.6;
    margin-bottom: 40px;
}

.company-logos {
    display: flex;
    gap: 40px;
    margin-bottom: 40px;
    color: #787A80;
    font-weight: 900;
    font-size: 16px;
}

.speaker-socials {
    display: flex;
    gap: 24px;
}

.speaker-socials a {
    text-decoration: none;
    color: #787A80;
    font-weight: 700;
    font-size: 18px;
}

.speaker-socials a.active, .speaker-socials a:hover {
    color: #FF3F3A;
}

/* For Whom Section */
.for-whom-section {
    padding: 60px 0 140px;
}

.for-whom-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 100px;
    align-items: start;
}

.for-whom-left h2 {
    font-size: 46px;
    font-weight: 900;
    line-height: 1.3;
}

.benefit-list {
    list-style: none;
}

.benefit-list li {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 20px;
}

.check-icon {
    color: #FF3F3A;
    font-weight: 900;
    font-size: 18px;
    border: 1.5px solid #FF3F3A;
    border-radius: 50%;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 3px;
}

.benefit-list p {
    font-size: 20px;
    font-weight: 700;
    line-height: 1.5;
    color: #1E212C;
}

/* Responsive */
@media (max-width: 992px) {
    .program-grid, .speaker-grid, .for-whom-grid {
        grid-template-columns: 1fr;
        gap: 50px;
    }
    .nav-links {
        display: none;
    }
    .main-title {
        font-size: 34px;
    }
}

